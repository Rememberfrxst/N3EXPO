# Use local or hosted PostgreSQL. Do not commit actual credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/griper
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-value
REFRESH_SECRET=replace-with-a-different-long-random-value
ADMIN_EMAIL=rememberfrxst@gmail.com
# ADMIN_PASSWORD is only needed for the one-time provision-owner command.
# Pass it through the environment; never place it in client configuration.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Optional direct image uploads (hosted image URLs also work without S3).
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional online payment endpoints. Storefront checkout currently uses COD.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
