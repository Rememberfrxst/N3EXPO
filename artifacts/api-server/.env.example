# ─────────────────────────────────────────────────────────────────────────────
# Meta E-Commerce API Server — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/meta_bytecode

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Use long random strings (min 32 chars) — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_string
REFRESH_SECRET=replace_with_a_different_long_random_secret_string
# Token expiry (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ── AWS S3 Image Upload (Phase 8) ─────────────────────────────────────────────
# IAM user should have ONLY s3:PutObject, s3:GetObject, s3:DeleteObject
# on the specific bucket — never use root credentials here.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=meta-griper-images

# Optional: CloudFront CDN domain (no trailing slash).
# If set, all image URLs will use this domain instead of s3.amazonaws.com.
# CDN_BASE_URL=https://d1234abcd.cloudfront.net

# ── Razorpay Payment (Phase 7) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
# Webhook secret for verifying incoming Razorpay events
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ── Pusher (Phase 5 — Push Notifications) ────────────────────────────────────
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
